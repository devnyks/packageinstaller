#!/bin/bash
# Fake flatpak for tests: records invocations and serves fixture output.
LOG="${FAKE_LOG:-/tmp/opencode/fakebin.log}"
FIXTURE="${FAKE_FIXTURE:-/tmp/opencode/fixtures}/flatpak"
echo "flatpak $*" >> "$LOG"

scope="system"
for a in "$@"; do
    [ "$a" = "--user" ] && scope="user"
done

case "$1" in
    remote-list)
        cat "$FIXTURE/remotes-$scope" 2>/dev/null
        ;;
    remote-ls)
        if echo "$*" | grep -q -- "--app"; then
            cat "$FIXTURE/apps-$scope" 2>/dev/null
        else
            cat "$FIXTURE/runtimes-$scope" 2>/dev/null
        fi
        ;;
    list)
        if echo "$*" | grep -q -- "--app"; then
            cat "$FIXTURE/installed-apps-$scope" 2>/dev/null
        elif echo "$*" | grep -q -- "--runtime"; then
            cat "$FIXTURE/installed-runtimes-$scope" 2>/dev/null
        elif echo "$*" | grep -q -- "--columns app,size"; then
            cat "$FIXTURE/sizes-$scope" 2>/dev/null
        fi
        ;;
    update|install|uninstall|remote-add|remote-delete)
        echo "flatpak ok"
        ;;
    *)
        ;;
esac
exit 0
