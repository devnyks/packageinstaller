<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/policykit-1/policyconfig-1.dtd">
<policyconfig>
  <action id="org.cachyos.cachyos-catalog.pkexec.run">
    <description>Run a CachyOS package operation</description>
    <message>Authentication is required to manage system packages</message>
    <icon_name>cachyos-catalog</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_FULL_BINDIR@/cachyos-catalog</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
